{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EpistulaMail",
  "version": "1.1.0",
  "identifier": "br.com.epistula.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EpistulaMail",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disk-cache-size=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "EpistulaMail",
    "copyright": "© 2026 Yuri Melo",
    "category": "Productivity",
    "shortDescription": "Cliente de e-mail desktop",
    "longDescription": "Cliente de e-mail que guarda as mensagens no seu computador, num banco cifrado, sem passar por um servidor do EpistulaMail.",
    "homepage": "https://www.epistulamail.com",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzQ0JCNzcwRTJDQzkxQkEKUldTNmtjemljTGZMQTBZZFpwUW9Ha1R6Z3U2ZS9UR29EUytCMjArQndCUWJ5czBtelVnTHpMMzUK",
      "endpoints": ["https://github.com/elyosemite/epistulamail/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
