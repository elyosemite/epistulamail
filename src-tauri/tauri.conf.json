{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epistula",
  "version": "1.0.1",
  "identifier": "br.com.epistula.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Epistula",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disk-cache-size=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Epistula",
    "copyright": "© 2026 Yuri Melo",
    "category": "Productivity",
    "shortDescription": "Cliente de e-mail desktop",
    "longDescription": "Cliente de e-mail que guarda as mensagens no seu computador, num banco cifrado, sem passar por um servidor do Epistula.",
    "homepage": "https://github.com/elyosemite/epistulamail",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
