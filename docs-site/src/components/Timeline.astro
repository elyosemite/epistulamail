---
// Timeline do DS (L80): vertical (padrão) ou horizontal. Estados: done, current, upcoming.
interface Item {
  date: string;
  title: string;
  body?: string;
  state?: "done" | "current" | "upcoming";
}
interface Props {
  items: Item[];
  horizontal?: boolean;
  label: string;
}
const { items, horizontal, label } = Astro.props;
---

<ol class:list={["timeline", "not-content", { "timeline--horizontal": horizontal }]} aria-label={label}>
  {
    items.map((item) => (
      <li class:list={["timeline__item", `is-${item.state ?? "done"}`]}>
        <span class="timeline__marker" aria-hidden="true">
          {(item.state ?? "done") === "done" && (
            <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          )}
        </span>
        <div class="timeline__content">
          <span class="timeline__date">{item.date}</span>
          <p class="timeline__title">{item.title}</p>
          {item.body && <p class="timeline__body">{item.body}</p>}
        </div>
      </li>
    ))
  }
</ol>
